# Copy to .env.local and fill in. All variables are optional; the site runs without them.

# Canonical domain, e.g. https://sumixjewels.com. Enables canonical URLs, the sitemap and
# structured data. Leave unset until the real domain is live.
NEXT_PUBLIC_SITE_URL=

# Server-only. Endpoint that receives newsletter sign-ups as POST { email, source }.
# Point it at your mailing-list provider (via a small proxy function) or an automation hook.
NEWSLETTER_WEBHOOK_URL=

# Server-only. Endpoint that receives contact enquiries and order enquiries as JSON
# (customer details, message, lines with server-recalculated prices, subtotal, currency).
ENQUIRY_WEBHOOK_URL=
